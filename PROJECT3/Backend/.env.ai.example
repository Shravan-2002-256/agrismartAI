# AI/ML Configuration - Add your API keys here
# For production deployment

# OpenAI Configuration (Optional - for GPT chatbot)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Google Generative AI (Optional - for Gemini chatbot)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-pro

# HuggingFace (Optional - for local transformers models)
HUGGINGFACE_API_KEY=your_huggingface_key_here

# TensorFlow Hub Settings
TENSORFLOW_HUB_CACHE_DIR=./cache/tfhub_modules

# Model Paths
MODEL_PATH=./models/disease_detection_efficientnet.h5
CROP_RECOMMENDATION_MODEL_PATH=./models/crop_recommendation.pkl

# Model Settings
MODEL_INPUT_SIZE=224
DISEASE_CONFIDENCE_THRESHOLD=0.75

# Market Price API (Optional - for real-time market data)
AGMARKNET_API_KEY=your_agmarknet_key_here
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Weather API (Optional - for weather forecasting)
OPENWEATHER_API_KEY=your_openweather_key_here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/agrismart

# AI Features Toggle (true/false)
ENABLE_AI_CHATBOT=true
ENABLE_ML_DISEASE_DETECTION=true
ENABLE_CROP_RECOMMENDATION=true
ENABLE_PRICE_PREDICTION=true

# Model Training Settings
TRAINING_BATCH_SIZE=32
TRAINING_EPOCHS=50
TRAINING_LEARNING_RATE=0.001

# Cache Settings
ENABLE_PREDICTION_CACHE=true
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO
ENABLE_ML_METRICS_LOGGING=true
