# Application
APP_NAME=AgriSmart AI
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - SQLite (Auth & Sessions) - No password needed!
DATABASE_URL=sqlite:///./agrismart.db

# Database - MongoDB Atlas (Production - Telemetry, History, Vector Search)
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGODB_URL=mongodb+srv://your_username:your_password@cluster0.mongodb.net/
MONGODB_DB=agrismart_production
MONGODB_VECTOR_SEARCH_ENABLED=true

# For local MongoDB (Development):
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB=agrismart_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Weather API (Get free key from https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ML Model Settings
MODEL_PATH=./models/disease_detection_mobilenetv2.h5
MODEL_INPUT_SIZE=224
DISEASE_CONFIDENCE_THRESHOLD=0.65  # HITL threshold

# TensorFlow Hub
TENSORFLOW_HUB_URL=https://tfhub.dev/google/imagenet/mobilenet_v2_100_224/feature_vector/5

# RAG Chatbot Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K_RESULTS=3
KNOWLEDGE_BASE_PATH=./data/knowledge_base

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Market Data (India specific)
AGMARKNET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
